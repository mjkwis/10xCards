# Supabase project URL and publishable key. Copy this file to `.env` for Node,
# or `.dev.vars` for Cloudflare local dev (`npx astro dev`/`wrangler`).
SUPABASE_URL=
SUPABASE_KEY=

# OpenRouter API key used server-side to generate flashcard candidates.
OPENROUTER_API_KEY=

# OpenRouter model id (must include the vendor prefix, e.g. "openai/gpt-4o-mini").
# Optional -- falls back to a hardcoded default in src/lib/services/openrouter.ts if unset.
OPENROUTER_MODEL=
