---
import Layout from "@/layouts/Layout.astro";
import { FlashcardsDashboard } from "@/components/flashcards/FlashcardsDashboard";
import { createClient } from "@/lib/supabase";
import { OPENROUTER_API_KEY } from "astro:env/server";
import type { Flashcard } from "@/types";

const { user } = Astro.locals;
const openRouterConfigured = Boolean(OPENROUTER_API_KEY);

let initialFlashcards: Flashcard[] = [];
let initialError = "";
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  initialError = "Supabase is not configured";
} else {
  const { data, error } = await supabase
    .from("flashcards")
    .select("*")
    .order("created_at", { ascending: false })
    .order("id", { ascending: false });
  if (error) {
    initialError = "Failed to load flashcards";
  } else {
    initialFlashcards = data as Flashcard[];
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen flex-col items-center gap-8 p-4 py-12">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
    <FlashcardsDashboard
      openRouterConfigured={openRouterConfigured}
      initialFlashcards={initialFlashcards}
      initialError={initialError}
      client:load
    />
  </div>
</Layout>
